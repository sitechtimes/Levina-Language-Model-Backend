meta {
  name: Join Session
  type: http
  seq: 3
}

post {
  url: {{base_url}}/sessions/join_session/
  body: json
  auth: none
}

body:json {
  {
    "student_name": "Samuel Kipnis",
    "access_code": "b27gdz"
  }
}

script:post-response {
  const responseBody = await res.getBody();
  const token = responseBody.token;
  
  if (token) {
    bru.setVar("session_token", token);
    console.log("✅ Token saved:", token);
  } else {
    console.error("❌ No token found in response!");
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
