meta {
  name: API Token (Student 2)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/token/
  body: json
  auth: none
}

body:json {
  {
      "email": "student2@example.com",
      "password": "student"
  }
}

script:post-response {
  const responseJson = res.getBody();
  bru.setVar("access_token", responseJson.access)
  bru.setVar("refresh_token", responseJson.refresh)
}

settings {
  encodeUrl: true
}
