meta {
  name: API Token Refresh
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/token/refresh/
  body: json
  auth: none
}

body:json {
  {
      "refresh": "{{refresh_token}}"
  }
}

script:post-response {
  const responseJson = res.getBody();
  bru.setVar("access_token", responseJson.access)
  
}

tests {
  test("response should contain refresh token", () => {
    expect(res.body).to.be.a("object");
  
    expect(res.body).to.have.property("access");
    expect(res.body.access).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
