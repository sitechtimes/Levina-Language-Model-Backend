meta {
  name: API Token (Sam)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/token/
  body: json
  auth: none
}

body:json {
  {
      "email": "sam.kipnis@gmail.com",
      "password": "password"
  }
}

script:post-response {
  const responseJson = res.getBody();
  bru.setVar("access_token", responseJson.access)
  bru.setVar("refresh_token", responseJson.refresh)
}

tests {
  test("response should contain refresh and access tokens", () => {
    expect(res.body).to.be.a("object");
  
    expect(res.body).to.have.property("refresh");
    expect(res.body.refresh).to.be.a("string");
  
    expect(res.body).to.have.property("access");
    expect(res.body.access).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
