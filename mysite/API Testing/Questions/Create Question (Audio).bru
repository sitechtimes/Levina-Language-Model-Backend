meta {
  name: Create Question (Audio)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/questions/
  body: multipartForm
  auth: inherit
}

body:json {
  {
      "question_type": "MCQ",
      "question_content_type": "TEXT",
      "text_question": "What is 3 + 5",
      "answer_content_type": "TEXT",
      "text_answer": "13",
      "false_answers": ["67", "41"]
  }
}

body:multipart-form {
  question_type: FRQ
  question_content_type: AUDIO
  audio_question: @file(/Users/sam/Downloads/images.jpg)
  answer_content_type: AUDIO
}

settings {
  encodeUrl: true
  timeout: 0
}
